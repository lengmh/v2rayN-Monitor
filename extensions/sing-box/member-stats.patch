+package adapter
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing/common"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Optional context hook; existing trackers and builds without member statistics are unchanged.
+type MonitorContextTracker interface {
+	MonitorContext(context.Context, Outbound) context.Context
+}
+
+type MonitorMeter struct {
+	Bind     func(Outbound)
+	Upload   N.CountFunc
+	Download N.CountFunc
+}
+
+type monitorMeterKey struct{}
+
+func WithMonitorMeter(ctx context.Context, meter *MonitorMeter) context.Context {
+	return context.WithValue(ctx, monitorMeterKey{}, meter)
+}
+
+func MonitorMeterFromContext(ctx context.Context) *MonitorMeter {
+	meter, _ := ctx.Value(monitorMeterKey{}).(*MonitorMeter)
+	return meter
+}
+
+func BindMonitorOutbound(ctx context.Context, outbound Outbound) {
+	if meter := MonitorMeterFromContext(ctx); meter != nil {
+		if _, group := outbound.(OutboundGroup); !group {
+			meter.Bind(outbound)
+		}
+	}
+}
+
+type monitorOutbound interface{ MonitorOutbound() Outbound }
+
+type monitorConn struct {
+	net.Conn
+	outbound Outbound
+}
+
+func (c *monitorConn) MonitorOutbound() Outbound { return c.outbound }
+func (c *monitorConn) Upstream() any             { return c.Conn }
+func (c *monitorConn) ReaderReplaceable() bool   { return true }
+func (c *monitorConn) WriterReplaceable() bool   { return true }
+
+type monitorPacketConn struct {
+	net.PacketConn
+	outbound Outbound
+}
+
+func (c *monitorPacketConn) MonitorOutbound() Outbound { return c.outbound }
+func (c *monitorPacketConn) Upstream() any             { return c.PacketConn }
+func (c *monitorPacketConn) ReaderReplaceable() bool   { return true }
+func (c *monitorPacketConn) WriterReplaceable() bool   { return true }
+
+// Attach evidence to the returned connection, not shared dial context: a losing parallel
+// dial must not bind the business stream that uses another successfully returned connection.
+func MonitorConnection(ctx context.Context, conn net.Conn, selected Outbound) net.Conn {
+	if MonitorMeterFromContext(ctx) == nil {
+		return conn
+	}
+	if _, group := selected.(OutboundGroup); group {
+		return conn
+	}
+	return &monitorConn{Conn: conn, outbound: selected}
+}
+
+func MonitorPacketConnection(ctx context.Context, conn net.PacketConn, selected Outbound) net.PacketConn {
+	if MonitorMeterFromContext(ctx) == nil {
+		return conn
+	}
+	if _, group := selected.(OutboundGroup); group {
+		return conn
+	}
+	return &monitorPacketConn{PacketConn: conn, outbound: selected}
+}
+
+func BindMonitorConnection(ctx context.Context, conn any) {
+	if meter := MonitorMeterFromContext(ctx); meter != nil {
+		if chosen, ok := common.Cast[monitorOutbound](conn); ok {
+			meter.Bind(chosen.MonitorOutbound())
+		} else {
+			meter.Bind(nil) // Unproved attribution stays unknown; it is never a current-selection guess.
+		}
+	}
+}
