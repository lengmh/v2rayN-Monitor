+func TestMonitorMemberBinding(t *testing.T) {
+	t.Run("old_connection_and_no_Now", func(t *testing.T) {
+		s := monitorServiceForTest()
+		g := monitorGroupForTest()
+		ctx := s.MonitorContext(context.Background(), g)
+		inbound := s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g)
+		chosen := adapter.MonitorConnection(ctx, monitorConnForTest(), monitorLeaf("a", C.TypeSOCKS))
+		chosen = adapter.MonitorConnection(ctx, chosen, g) // Nested group preserves the returned leaf.
+		adapter.BindMonitorConnection(ctx, chosen)
+		monitorExercise(t, inbound)
+		adapter.BindMonitorOutbound(ctx, monitorLeaf("b", C.TypeSOCKS))
+		monitorExercise(t, inbound)
+		counts := monitorCountsForTest(t, s)
+		monitorCheckPair(t, counts, "monitor>>>member>>>a", 6, 4)
+		monitorCheckPair(t, counts, "monitor>>>member>>>b", 0, 0)
+		monitorCheckPair(t, counts, "monitor>>>business", 6, 4)
+		monitorCheckPair(t, counts, "outbound>>>g", 6, 4)
+		monitorCheckPair(t, counts, "monitor>>>unknown", 0, 0)
+	})
+	t.Run("returned_winner_not_first_successful_attempt", func(t *testing.T) {
+		s := monitorServiceForTest()
+		g := monitorGroupForTest()
+		ctx := s.MonitorContext(context.Background(), g)
+		_ = adapter.MonitorConnection(ctx, monitorConnForTest(), monitorLeaf("a", C.TypeSOCKS))
+		winner := adapter.MonitorConnection(ctx, monitorConnForTest(), monitorLeaf("b", C.TypeSOCKS))
+		adapter.BindMonitorConnection(ctx, winner)
+		inbound := s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g)
+		monitorExercise(t, inbound)
+		counts := monitorCountsForTest(t, s)
+		monitorCheckPair(t, counts, "monitor>>>member>>>a", 0, 0)
+		monitorCheckPair(t, counts, "monitor>>>member>>>b", 3, 2)
+	})
+	t.Run("packet_connection_evidence", func(t *testing.T) {
+		s := monitorServiceForTest()
+		g := monitorGroupForTest()
+		ctx := s.MonitorContext(context.Background(), g)
+		packet := adapter.MonitorPacketConnection(ctx, &monitorSyntheticPacket{}, monitorLeaf("b", C.TypeSOCKS))
+		packet = adapter.MonitorPacketConnection(ctx, packet, g)
+		adapter.BindMonitorConnection(ctx, packet)
+		meter := adapter.MonitorMeterFromContext(ctx)
+		meter.Upload(3)
+		meter.Download(2)
+		monitorCheckPair(t, monitorCountsForTest(t, s), "monitor>>>member>>>b", 3, 2)
+	})
+	cases := []struct {
+		name      string
+		leaf      adapter.Outbound
+		dimension string
+	}{
+		{"direct_excluded", monitorLeaf("direct", C.TypeDirect), "excluded"},
+		{"unregistered_unknown", monitorLeaf("unregistered", C.TypeSOCKS), "unknown"},
+		{"chain_unknown", monitorLeaf("a", C.TypeSOCKS, "b"), "unknown"},
+		{"unresolved_unknown", nil, "unknown"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := monitorServiceForTest()
+			g := monitorGroupForTest()
+			ctx := s.MonitorContext(context.Background(), g)
+			adapter.BindMonitorOutbound(ctx, tc.leaf)
+			monitorExercise(t, s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g))
+			counts := monitorCountsForTest(t, s)
+			monitorCheckPair(t, counts, "monitor>>>"+tc.dimension, 3, 2)
+			monitorCheckPair(t, counts, "monitor>>>business", 0, 0)
+			monitorCheckPair(t, counts, "monitor>>>member>>>a", 0, 0)
+			monitorCheckPair(t, counts, "monitor>>>member>>>b", 0, 0)
+		})
+	}
+	t.Run("early_bytes_stay_unknown", func(t *testing.T) {
+		s := monitorServiceForTest()
+		g := monitorGroupForTest()
+		ctx := s.MonitorContext(context.Background(), g)
+		inbound := s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g)
+		monitorExercise(t, inbound)
+		adapter.BindMonitorOutbound(ctx, monitorLeaf("a", C.TypeSOCKS))
+		monitorExercise(t, inbound)
+		counts := monitorCountsForTest(t, s)
+		monitorCheckPair(t, counts, "monitor>>>unknown", 6, 4)
+		monitorCheckPair(t, counts, "monitor>>>business", 0, 0)
+	})
+}
+
+func TestMonitorMemberConcurrentIndependentConnections(t *testing.T) {
+	s := monitorServiceForTest()
+	g := monitorGroupForTest()
+	var workers sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		workers.Add(1)
+		go func(worker int) {
+			defer workers.Done()
+			tag := "a"
+			if worker%2 != 0 {
+				tag = "b"
+			}
+			for i := 0; i < 100; i++ {
+				ctx := s.MonitorContext(context.Background(), g)
+				adapter.BindMonitorOutbound(ctx, monitorLeaf(tag, C.TypeSOCKS))
+				conn := s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g)
+				monitorExercise(t, conn)
+			}
+		}(worker)
+	}
+	workers.Wait()
+	counts := monitorCountsForTest(t, s)
+	monitorCheckPair(t, counts, "monitor>>>member>>>a", 1200, 800)
+	monitorCheckPair(t, counts, "monitor>>>member>>>b", 1200, 800)
+	monitorCheckPair(t, counts, "monitor>>>business", 2400, 1600)
+	monitorCheckPair(t, counts, "monitor>>>unknown", 0, 0)
+}
+
+func TestMonitorMembersDisabledPreservesOriginalCounters(t *testing.T) {
+	s := api.NewStatsService(option.V2RayStatsServiceOptions{Enabled: true, Outbounds: []string{"g"}})
+	g := monitorGroupForTest()
+	original := context.Background()
+	ctx := s.MonitorContext(original, g)
+	if ctx != original || adapter.MonitorMeterFromContext(ctx) != nil {
+		t.Fatal("disabled hook changed context")
+	}
+	monitorExercise(t, s.RoutedConnection(ctx, monitorConnForTest(), adapter.InboundContext{}, nil, g))
+	counts := monitorCountsForTest(t, s)
+	if len(counts) != 2 {
+		t.Fatal("member counters enabled without opt-in", counts)
+	}
+	monitorCheckPair(t, counts, "outbound>>>g", 3, 2)
+}
