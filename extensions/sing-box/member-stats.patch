+package v2rayapi
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func (s *StatsService) MonitorContext(ctx context.Context, matched adapter.Outbound) context.Context {
+	if len(s.monitorMembers) == 0 {
+		return ctx
+	}
+	meter := &monitorMemberMeter{service: s}
+	if _, group := matched.(adapter.OutboundGroup); !group {
+		meter.bind(matched)
+	}
+	return adapter.WithMonitorMeter(ctx, &adapter.MonitorMeter{
+		Bind:     meter.bind,
+		Upload:   func(n int64) { meter.count(n, true) },
+		Download: func(n int64) { meter.count(n, false) },
+	})
+}
+
+type monitorCounterPair struct{ upload, download *atomic.Int64 }
+
+type monitorMemberMeter struct {
+	access  sync.Mutex
+	service *StatsService
+	bound   bool
+	member  monitorCounterPair
+	total   monitorCounterPair
+}
+
+func (m *monitorMemberMeter) bind(outbound adapter.Outbound) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if !m.bound {
+		m.bindLocked(outbound)
+	}
+}
+
+func (m *monitorMemberMeter) bindLocked(outbound adapter.Outbound) {
+	dimension := "unknown"
+	member := ""
+	// A leaf with outbound dependencies is a chain, not a proven independent member.
+	if outbound != nil && len(outbound.Dependencies()) == 0 {
+		switch outbound.Type() {
+		case C.TypeDirect:
+			dimension = "excluded"
+		case C.TypeSOCKS, C.TypeHTTP, C.TypeShadowsocks, C.TypeVMess, C.TypeVLESS, C.TypeTrojan, C.TypeAnyTLS, C.TypeHysteria2, C.TypeTUIC:
+			if m.service.monitorMembers[outbound.Tag()] {
+				dimension = "business"
+				member = outbound.Tag()
+			}
+		}
+	}
+	m.service.access.Lock()
+	pair := func(prefix string) monitorCounterPair {
+		return monitorCounterPair{
+			m.service.counters[prefix+">>>traffic>>>uplink"],
+			m.service.counters[prefix+">>>traffic>>>downlink"],
+		}
+	}
+	m.total = pair("monitor>>>" + dimension)
+	if member != "" {
+		m.member = pair("monitor>>>member>>>" + member)
+	}
+	m.service.access.Unlock()
+	m.bound = true
+}
+
+func (m *monitorMemberMeter) count(n int64, upload bool) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	// Unexpected bytes before resolution freeze as unknown, not retroactively reassigned.
+	if !m.bound {
+		m.bindLocked(nil)
+	}
+	if upload {
+		if m.member.upload != nil {
+			m.member.upload.Add(n)
+		}
+		m.total.upload.Add(n)
+	} else {
+		if m.member.download != nil {
+			m.member.download.Add(n)
+		}
+		m.total.download.Add(n)
+	}
+}
