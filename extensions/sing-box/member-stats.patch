+// These are synthetic connection-path counters, never client/profile identity acceptance.
+type monitorSyntheticOutbound struct{ OA.Adapter }
+
+func (o *monitorSyntheticOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	panic("not a test dial")
+}
+func (o *monitorSyntheticOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	panic("not a test listen")
+}
+
+type monitorSyntheticGroup struct{ monitorSyntheticOutbound }
+
+func (g *monitorSyntheticGroup) Now() string   { panic("instantaneous group selection must not be read") }
+func (g *monitorSyntheticGroup) All() []string { return []string{"a", "b"} }
+
+type monitorSyntheticConn struct{ *bytes.Reader }
+
+func (c *monitorSyntheticConn) Write(p []byte) (int, error)      { return len(p), nil }
+func (c *monitorSyntheticConn) Close() error                     { return nil }
+func (c *monitorSyntheticConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *monitorSyntheticConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *monitorSyntheticConn) SetDeadline(time.Time) error      { return nil }
+func (c *monitorSyntheticConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *monitorSyntheticConn) SetWriteDeadline(time.Time) error { return nil }
+
+type monitorSyntheticPacket struct{ net.PacketConn }
+
+func monitorConnForTest() net.Conn { return &monitorSyntheticConn{bytes.NewReader(make([]byte, 100))} }
+func monitorLeaf(tag, kind string, dependencies ...string) adapter.Outbound {
+	return &monitorSyntheticOutbound{OA.NewAdapter(kind, tag, []string{"tcp", "udp"}, dependencies)}
+}
+func monitorGroupForTest() adapter.Outbound {
+	return &monitorSyntheticGroup{monitorSyntheticOutbound{OA.NewAdapter(C.TypeSelector, "g", []string{"tcp", "udp"}, []string{"a", "b"})}}
+}
+func monitorServiceForTest() *api.StatsService {
+	return api.NewStatsService(option.V2RayStatsServiceOptions{Enabled: true, Outbounds: []string{"g"}, MonitorMembers: []string{"a", "b"}})
+}
+func monitorCountsForTest(t *testing.T, s *api.StatsService) map[string]int64 {
+	t.Helper()
+	response, err := s.QueryStats(context.Background(), &api.QueryStatsRequest{Reset_: false})
+	if err != nil {
+		t.Fatal(err)
+	}
+	counts := make(map[string]int64)
+	for _, stat := range response.Stat {
+		counts[stat.Name] = stat.Value
+	}
+	return counts
+}
+func monitorCheckPair(t *testing.T, counts map[string]int64, prefix string, up, down int64) {
+	t.Helper()
+	if counts[prefix+">>>traffic>>>uplink"] != up || counts[prefix+">>>traffic>>>downlink"] != down {
+		t.Fatalf("%s pair mismatch: %v", prefix, counts)
+	}
+}
+func monitorExercise(t *testing.T, conn net.Conn) {
+	t.Helper()
+	if n, err := conn.Read(make([]byte, 3)); n != 3 || err != nil {
+		t.Fatal("synthetic read", n, err)
+	}
+	if n, err := conn.Write(make([]byte, 2)); n != 2 || err != nil {
+		t.Fatal("synthetic write", n, err)
+	}
+}
