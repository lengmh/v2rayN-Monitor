+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+// Synthetic sidecar only. No client configuration or credentials are loaded.
+func TestMonitorMemberSidecar(t *testing.T) {
+	globalCtx = context.Background()
+	entries := []*OptionsEntry{{options: option.Options{Outbounds: []option.Outbound{
+		{Type: "anytls", Tag: "proxy"}, {Type: "vmess", Tag: "fixture-b"},
+		{Type: "direct", Tag: "direct"}, {Type: "selector", Tag: "group"},
+	}}}}
+	path := filepath.Join(t.TempDir(), "monitor-stats.json")
+	cases := []struct {
+		name, content string
+		valid         bool
+	}{
+		{"explicit_members", `{"listen":"127.0.0.1:10814","monitor_members":["proxy","fixture-b"]}`, true},
+		{"duplicate", `{"listen":"127.0.0.1:10814","monitor_members":["proxy","proxy"]}`, false},
+		{"unregistered", `{"listen":"127.0.0.1:10814","monitor_members":["absent"]}`, false},
+		{"direct", `{"listen":"127.0.0.1:10814","monitor_members":["direct"]}`, false},
+		{"group", `{"listen":"127.0.0.1:10814","monitor_members":["group"]}`, false},
+		{"separator", `{"listen":"127.0.0.1:10814","monitor_members":["bad>>>tag"]}`, false},
+		{"wrong_type", `{"listen":"127.0.0.1:10814","monitor_members":true}`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := os.WriteFile(path, []byte(tc.content), 0600); err != nil {
+				t.Fatal(err)
+			}
+			got, err := readMonitorStatsAt(path, entries)
+			if (err == nil) != tc.valid {
+				t.Fatalf("valid=%v, err=%v", tc.valid, err)
+			}
+			if tc.valid {
+				stats := got.options.Experimental.V2RayAPI.Stats
+				if !reflect.DeepEqual(stats.MonitorMembers, []string{"proxy", "fixture-b"}) ||
+					!reflect.DeepEqual(stats.Outbounds, []string{"proxy"}) {
+					t.Fatal("member or original route scope changed")
+				}
+				if len(got.options.Outbounds) != 0 || got.options.Route != nil || got.options.DNS != nil {
+					t.Fatal("sidecar changed routing or node configuration")
+				}
+			}
+		})
+	}
+	if err := os.WriteFile(path, []byte(`{"listen":"127.0.0.1:10814"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	got, err := readMonitorStatsAt(path, entries)
+	if err != nil || len(got.options.Experimental.V2RayAPI.Stats.MonitorMembers) != 0 {
+		t.Fatal("listen-only sidecar must not enable member collection", err)
+	}
+}
