+package main
+
+import (
+	"bytes"
+	stdjson "encoding/json"
+	"fmt"
+	"io"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+)
+
+// This experimental build reads only a statistics endpoint, never node or routing overrides.
+func readMonitorStats(entries []*OptionsEntry) (*OptionsEntry, error) {
+	if len(configPaths) != 1 || len(configDirectories) != 0 || !strings.EqualFold(filepath.Base(configPaths[0]), "config.json") {
+		return nil, nil
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		return nil, err
+	}
+	name := strings.TrimSuffix(strings.ToLower(filepath.Base(executable)), ".exe")
+	if name != "sing-box-client" {
+		return nil, nil
+	}
+	return readMonitorStatsAt(filepath.Join(filepath.Dir(executable), "monitor-stats.json"), entries)
+}
+
+func readMonitorStatsAt(path string, entries []*OptionsEntry) (*OptionsEntry, error) {
+	content, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("read Monitor statistics endpoint: %w", err)
+	}
+	if len(content) > 4096 {
+		return nil, fmt.Errorf("Monitor statistics file exceeds 4096 bytes")
+	}
+	var endpoint struct {
+		Listen string `json:"listen"`
+	}
+	decoder := stdjson.NewDecoder(bytes.NewReader(content))
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&endpoint); err != nil {
+		return nil, fmt.Errorf("invalid Monitor statistics file: %w", err)
+	}
+	if err = decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("Monitor statistics file must contain one JSON object")
+	}
+	address, err := netip.ParseAddrPort(endpoint.Listen)
+	if err != nil || !address.Addr().IsLoopback() || address.Port() == 0 {
+		return nil, fmt.Errorf("Monitor statistics endpoint must be a numeric loopback address with a nonzero port")
+	}
+	proxies := 0
+	for _, entry := range entries {
+		if entry.options.Experimental != nil && entry.options.Experimental.V2RayAPI != nil {
+			return nil, fmt.Errorf("generated configuration already specifies V2Ray API")
+		}
+		for _, outbound := range entry.options.Outbounds {
+			if outbound.Tag == "proxy" {
+				proxies++
+			}
+		}
+	}
+	if proxies != 1 {
+		return nil, fmt.Errorf("Monitor statistics require one proxy outbound")
+	}
+	overlay := map[string]any{"experimental": map[string]any{"v2ray_api": map[string]any{
+		"listen": endpoint.Listen, "stats": map[string]any{"enabled": true, "outbounds": []string{"proxy"}},
+	}}}
+	encoded, err := stdjson.Marshal(overlay)
+	if err != nil {
+		return nil, err
+	}
+	options, err := json.UnmarshalExtendedContext[option.Options](globalCtx, encoded)
+	if err != nil {
+		return nil, err
+	}
+	return &OptionsEntry{content: encoded, path: path, options: options}, nil
+}
