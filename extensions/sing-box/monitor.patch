+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+)
+
+func TestMonitorStatsEndpoint(t *testing.T) {
+	globalCtx = context.Background()
+	entries := []*OptionsEntry{{options: option.Options{Outbounds: []option.Outbound{{Type: "direct", Tag: "proxy"}}}}}
+	dir := t.TempDir()
+	path := filepath.Join(dir, "monitor-stats.json")
+	if got, err := readMonitorStatsAt(path, entries); err != nil || got != nil {
+		t.Fatal("missing optional file must not enable API", err)
+	}
+	cases := []struct {
+		name, content string
+		valid         bool
+	}{
+		{"loopback", `{"listen":"127.0.0.1:10814"}`, true},
+		{"ipv6_loopback", `{"listen":"[::1]:10814"}`, true},
+		{"public_bind", `{"listen":"0.0.0.0:10814"}`, false},
+		{"hostname", `{"listen":"localhost:10814"}`, false},
+		{"zero_port", `{"listen":"127.0.0.1:0"}`, false},
+		{"routing_override", `{"listen":"127.0.0.1:10814","route":{}}`, false},
+		{"trailing_json", `{"listen":"127.0.0.1:10814"}{}`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := os.WriteFile(path, []byte(tc.content), 0600); err != nil {
+				t.Fatal(err)
+			}
+			got, err := readMonitorStatsAt(path, entries)
+			if (err == nil) != tc.valid {
+				t.Fatalf("valid=%v, err=%v", tc.valid, err)
+			}
+			if tc.valid {
+				stats := got.options.Experimental.V2RayAPI.Stats
+				if !stats.Enabled || len(stats.Outbounds) != 1 || stats.Outbounds[0] != "proxy" || len(stats.Inbounds) != 0 {
+					t.Fatal("statistics scope changed")
+				}
+				if len(got.options.Outbounds) != 0 || got.options.Route != nil || got.options.DNS != nil {
+					t.Fatal("overlay changes connection configuration")
+				}
+			}
+		})
+	}
+	if err := os.WriteFile(path, []byte(`{"listen":"127.0.0.1:10814"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	conflicting := []*OptionsEntry{{options: option.Options{Experimental: &option.ExperimentalOptions{V2RayAPI: &option.V2RayAPIOptions{}}}}}
+	if _, err := readMonitorStatsAt(path, conflicting); err == nil {
+		t.Fatal("existing V2Ray settings overwritten")
+	}
+	if _, err := readMonitorStatsAt(path, nil); err == nil {
+		t.Fatal("missing proxy accepted")
+	}
+	_, err := json.UnmarshalExtendedContext[option.Options](globalCtx, []byte(`{}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+}
